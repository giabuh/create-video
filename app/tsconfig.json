{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "skipLibCheck": true, "resolveJsonModule": true, "types": ["node", "vite/client"],
    "baseUrl": ".", "paths": {"@studio/*": ["../studio/src/*"]}
  },
  "include": ["src", "server", "shared", "e2e", "vite.config.ts", "vitest.config.ts", "../studio/src"]
}
